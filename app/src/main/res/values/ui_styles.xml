<resources>
    <style name="UiColumn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style
        name="UiCard"
        parent="UiColumn">
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:background">@drawable/card_background</item>
    </style>
    <style name="UiText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style
        name="UiMuted"
        parent="UiText">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style
        name="UiHelp"
        parent="UiMuted">
        <item name="android:textSize">12sp</item>
    </style>
    <style
        name="UiHeading"
        parent="UiText">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style
        name="UiSection"
        parent="UiMuted">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style
        name="UiButton"
        parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_ink</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/ui_surface</item>
        <item name="strokeColor">@color/ui_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style
        name="UiPrimaryButton"
        parent="UiButton">
        <item name="android:textColor">@color/ui_paper</item>
        <item name="backgroundTint">@color/ui_ink</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style
        name="UiTab"
        parent="UiButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">@color/tab_background</item>
        <item name="android:textColor">@color/tab_text</item>
    </style>
    <style
        name="UiKeywordLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="UiKeywordInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:minLines">2</item>
        <item name="android:maxLines">6</item>
        <item name="android:gravity">top</item>
        <item name="android:textColor">@color/ui_ink</item>
    </style>
</resources>
